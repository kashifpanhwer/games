  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.21.0",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "file-type": "^22.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "mime-types": "^3.0.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
