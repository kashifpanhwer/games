{
  "name": "kashif-tech-advance-bot",
  "version": "2.0.0",
  "description": "Kashif Tech Advance Bot - an advanced multi-device WhatsApp bot with a button-based menu, pairing-code login, plugin architecture and a live web control panel.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "pair": "node index.js --pair",
    "qr": "node index.js --qr",
    "panel": "node index.js --panel-only",
    "test": "node test/smoke.mjs",
    "clean": "node scripts/clean-session.js",
    "preview": "node scripts/preview-menu.mjs",
    "preview:json": "node scripts/preview-menu.mjs --json",
    "doctor": "node scripts/doctor.mjs",
    "termux": "bash scripts/install-termux.sh"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "whatsapp-bot",
    "pairing-code",
    "kashif-tech",
    "multi-device"
  ],
