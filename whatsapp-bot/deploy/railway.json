{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "npm ci --omit=dev" },
  "deploy": {
    "startCommand": "node --dns-result-order=ipv4first index.js --pair",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "env": { "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt" }
  }
}
