# ============================================================
#  KASHIF TECH ADVANCE BOT  —  configuration
#  Copy this file to `.env` and edit the values.
# ============================================================

# --- Bot identity ------------------------------------------------
BOT_NAME=Kashif Tech Advance Bot
BOT_AUTHOR=Kashif Tech
PACK_NAME=Kashif Tech
PACK_PUBLISHER=Kashif Tech Advance Bot

# --- Your WhatsApp number (used with --pair) --------------------
# Country code + number, digits only. No +, no spaces, no dashes.
PAIRING_NUMBER=923145396910

# --- Owner numbers (comma separated, full JID or digits) --------
OWNER_NUMBER=923145396910
OWNER_NAME=Kashif

# --- Login mode --------------------------------------------------
# pair  = show an 8-character pairing code (Link with phone number)
# qr    = show a QR code in terminal + web panel
AUTH_MODE=pair

# Optional: force your OWN 8-character pairing code.
# Must be exactly 8 characters from A-Z / 0-9 (no I, L, O, U).
# Leave empty to let WhatsApp generate a random one.
CUSTOM_PAIRING_CODE=

# --- Web control panel ------------------------------------------
PANEL_ENABLED=true
PANEL_HOST=0.0.0.0
PANEL_PORT=3000
# Change this! Used as ?token= on the panel URL.
PANEL_TOKEN=kashiftech

# --- Session storage --------------------------------------------
SESSION_DIR=./sessions

# --- Menu style --------------------------------------------------
# buttons  = native WhatsApp quick-reply buttons (default, auto-falls back)
# carousel = swipeable card menu with buttons per card
# list     = single-select list message
# text     = plain numbered text menu (works on every account)
MENU_TYPE=buttons

# --- Prefixes ----------------------------------------------------
PREFIX=.
MULTI_PREFIX=true

# --- Feature switches -------------------------------------------
ANTI_LINK=false
ANTI_VIEWONCE=true
ANTI_DELETE=false
WELCOME=true
GOODBYE=true
AUTO_TYPING=true
AUTO_READ=false
NSFW=false
PUBLIC_MODE=true

# --- API keys (all optional) -------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
SHOTTOKEN=
UPLOAD_HOST=https://tmpfiles.org/api/v1/upload

# --- Rate limiting -----------------------------------------------
LIMIT_ENABLED=true
LIMIT_PER_DAY=100
COOLDOWN_SECONDS=2
